# Postgres partilhado com o garmin-worker
DATABASE_URL=postgres://merlin:merlin@localhost:5432/merlin

# Chave para encriptar tokens OAuth antes de gravar em connected_accounts.
# Gerar com: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Strava OAuth2
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/callback

# Ligações ao worker Garmin
GARMIN_WORKER_URL=http://localhost:8000
GARMIN_WORKER_SERVICE_TOKEN=change-me-local-dev-only

# Token que o garmin-worker usa para chamar de volta /api/internal/recompute
# depois de um sync — tem de bater certo com SERVICE_TOKEN no worker.
WEB_INTERNAL_SERVICE_TOKEN=change-me-local-dev-only

# Claude
ANTHROPIC_API_KEY=
