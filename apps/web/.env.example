# Postgres partilhado com o garmin-worker
DATABASE_URL=postgres://merlin:merlin@localhost:5432/merlin

# Chave para encriptar tokens/credenciais antes de gravar em
# connected_accounts. Gerar com: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# NextAuth — assina os cookies de sessão. Gerar com: openssl rand -base64 32
AUTH_SECRET=
# Só necessário em produção (URL pública real); em dev local o NextAuth
# deduz http://localhost:3000 sozinho.
# AUTH_URL=https://app.merlin.example

# Strava OAuth2 — a "Authorization Callback Domain" configurada em
# strava.com/settings/api tem de incluir este domínio. O caminho exato do
# callback (/api/auth/callback/strava) é gerido pelo NextAuth, não precisa
# de ser registado à parte.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Ligações ao worker Garmin
GARMIN_WORKER_URL=http://localhost:8000
GARMIN_WORKER_SERVICE_TOKEN=change-me-local-dev-only

# Token que o garmin-worker usa para chamar de volta /api/internal/recompute
# depois de um sync — tem de bater certo com SERVICE_TOKEN no worker.
WEB_INTERNAL_SERVICE_TOKEN=change-me-local-dev-only

# Claude
ANTHROPIC_API_KEY=

# Protege /api/cron/* — o Vercel Cron manda isto automaticamente como
# Authorization: Bearer <valor> quando esta variável está definida no
# projeto. Outro runner (Trigger.dev, Inngest, cron do sistema) tem de
# mandar o mesmo header manualmente. Gerar com: openssl rand -base64 32
CRON_SECRET=
