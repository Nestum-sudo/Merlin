DATABASE_URL=postgresql://merlin:merlin@localhost:5432/merlin
SERVICE_TOKEN=change-me-local-dev-only

# Para chamar de volta /api/internal/recompute depois de um sync — tem de
# bater certo com WEB_INTERNAL_SERVICE_TOKEN em apps/web/.env.local
WEB_APP_URL=http://localhost:3000
WEB_APP_INTERNAL_TOKEN=change-me-local-dev-only

# Tem de ser exatamente o mesmo valor que APP_ENCRYPTION_KEY em
# apps/web/.env.local — é a chave partilhada que permite a este worker
# desencriptar as credenciais Garmin que o web gravou em connected_accounts.
APP_ENCRYPTION_KEY=

# Credenciais Garmin por utilizador ficam encriptadas na tabela
# connected_accounts, não aqui — isto é só configuração do próprio serviço.
